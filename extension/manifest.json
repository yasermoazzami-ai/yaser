{
  "manifest_version": 3,
  "name": "TSETMC Stocks Radar Pro",
  "version": "8.17.1",
  "description": "نسخه 8.17.0: خروجی داده (قیمت، حقیقی/حقوقی، EPS و کدال) برای تحلیل فنی و بنیادی + اسکن هوشمند روزانه",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://cdn.tsetmc.com/*",
    "https://old.tsetmc.com/*",
    "http://old.tsetmc.com/*",
    "https://www.tsetmc.com/*",
    "https://service.tsetmc.com/*",
    "http://service.tsetmc.com/*",
    "https://search.codal.ir/*",
    "https://excel.codal.ir/*",
    "https://codal.ir/*"
  ],
  "action": {
    "default_title": "TSETMC Stocks Radar Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
